# Copy this file to `.env` in the repo root and fill in real values.
# Never commit `.env`. GitHub stores code only — keys stay on this machine.

# --- Postgres (API + Drizzle) ---
# Neon: Dashboard → your project → Connect → copy the URI.
# Use the direct (non-pooled) connection string for migrations.
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# --- Clerk (API) ---
# Dashboard → Configure → API keys (Development instance)
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# --- Clerk (Vite frontend) ---
# Same value as CLERK_PUBLISHABLE_KEY. Leave VITE_CLERK_PROXY_URL unset for local dev.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_

# --- Local ports ---
NODE_ENV=development

# Frontend (Vite). Defaults are PORT=5173 and BASE_PATH=/ if omitted.
PORT=5173
BASE_PATH=/

# API server. Keep this different from PORT when running both locally.
API_PORT=3000

# --- Vercel (set in the Vercel dashboard, not in git) ---
# DATABASE_URL          Neon *pooled* URI (serverless). Keep sslmode=require.
# CLERK_PUBLISHABLE_KEY Development pk_test_ first; pk_live_ only on a Clerk Production instance
# CLERK_SECRET_KEY
# VITE_CLERK_PUBLISHABLE_KEY  same as CLERK_PUBLISHABLE_KEY (needed at BUILD time)
# CORS_ORIGIN           optional extra origin, e.g. https://your-domain.com
# SEED_DEMO             leave unset in production (demo data stays off)

