{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./build.mjs && node --env-file=../../.env --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "build:vercel": "node ./build.mjs --vercel",
    "start": "node --env-file=../../.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/lib/auth-roles.test.ts src/lib/report-workflow.test.ts src/lib/asset-lifecycle.test.ts src/lib/notify-recipients.test.ts src/lib/notify-safe.test.ts src/lib/email.test.ts src/lib/cron-auth.test.ts src/lib/warranty-alerts.test.ts src/lib/lookup-rules.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.64",
    "@clerk/shared": "^4.30.2",
    "@vercel/blob": "^2.8.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.4.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
