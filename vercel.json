{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -w run build:vercel",
  "outputDirectory": "artifacts/asset-control/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/warranty",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/cron/custody",
      "schedule": "0 9 * * *"
    }
  ]
}
